# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=SocialPilot AI
APP_PORT=3000
# Public base URL of this API. Social platforms (Instagram/Facebook) download
# media from APP_URL/uploads/..., so in production this MUST be a public HTTPS URL.
APP_URL=http://localhost:3000
# Angular app URL (used for CORS and OAuth redirects back to the UI)
# Single-app mode (backend serves the built UI): set this equal to APP_URL.
WEB_APP_URL=http://localhost:4200
# Built Angular app this server also serves (npm run build:all). Ignored if the
# build is missing; set to empty to disable. Relative to the backend folder.
WEB_DIST_PATH=../web/dist/web/browser
# Comma separated list of extra allowed CORS origins
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.4+; manage it with phpMyAdmin if you like)
# ---------------------------------------------------------------------------
# mysql (MySQL 8) or mariadb (XAMPP / MariaDB 10.4+)
DATABASE_TYPE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=social_media_platform
DATABASE_LOGGING=false

# ---------------------------------------------------------------------------
# Auth (generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=30d

# 32-byte key, base64 encoded, used to encrypt social tokens at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Defaults only: admins can change providers, models and keys at runtime in
# the web app (Admin > AI providers); values saved there override these.
# Text and image: openai | nvidia | custom. Video: openai only.
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
AI_VIDEO_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2
# NVIDIA API key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# Any OpenAI-compatible API (OpenRouter, Groq, DeepSeek, Gemini, Together, Ollama...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_TEXT_MODEL=
CUSTOM_AI_IMAGE_MODEL=

# ---------------------------------------------------------------------------
# Meta / Facebook (Facebook Pages; also Instagram when INSTAGRAM_* is empty)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/v1/social-accounts/facebook/callback
META_GRAPH_VERSION=v25.0

# ---------------------------------------------------------------------------
# Instagram (separate app, "Instagram API with Instagram Login" - no Facebook Page needed)
# App dashboard -> Instagram -> API setup with Instagram login -> Instagram app ID / secret.
# Leave empty to connect Instagram through the Meta app above (Facebook Login + Page).
# ---------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/social-accounts/instagram/callback

# ---------------------------------------------------------------------------
# Google (YouTube Data API v3)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/social-accounts/youtube/callback

# ---------------------------------------------------------------------------
# LinkedIn (Community Management API / Share on LinkedIn)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/v1/social-accounts/linkedin/callback
# LinkedIn-Version header (YYYYMM). LinkedIn retires versions after ~12 months.
LINKEDIN_API_VERSION=202608
# Member posting: "openid profile w_member_social". Company pages (Community Management API approval required):
# "openid profile w_member_social w_organization_social r_organization_social rw_organization_admin"
LINKEDIN_SCOPES=openid profile w_member_social

# Extra allowed OAuth return URLs (comma separated), e.g. a mobile deep link: socialpilot://oauth
OAUTH_ALLOWED_RETURN_URLS=

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Storage: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
# Optional: ffprobe binary used to read video duration/dimensions (install FFmpeg)
FFPROBE_PATH=ffprobe
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN / public base URL for S3 objects
AWS_S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Seed (npm run seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@socialpilot.local
SEED_ADMIN_PASSWORD=Admin@12345
